# ==============================================================================
# FRONTEND CONFIGURATION (Vite - Safe for browser)
# ==============================================================================

# Cashfree JS SDK Mode: "production" or "sandbox" (defaults to production)
VITE_CASHFREE_MODE=production

# Public site URL
VITE_SITE_URL=https://digital-contents.pages.dev

# ==============================================================================
# SERVER-SIDE SECRETS (Cloudflare Pages / Workers Only)
# DO NOT commit real secrets to Git.
# Configure these in Cloudflare Dashboard (Pages > Settings > Environment variables)
# or for local testing with `wrangler pages dev`, put them in `.dev.vars`:
# ==============================================================================
# CASHFREE_APP_ID=your_cashfree_app_id
# CASHFREE_SECRET_KEY=your_cashfree_secret_key
# CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret (optional)
# CASHFREE_ENVIRONMENT=production
# CASHFREE_API_VERSION=2023-08-01
# SITE_URL=https://digital-contents.pages.dev
# PDF_OBJECT_KEY=artificial-intelligence-beginners.pdf
# DOWNLOAD_SIGNING_SECRET=your_random_secret_string_for_download_token_signing
